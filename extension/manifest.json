{
  "manifest_version": 3,
  "name": "WebPilot",
  "description": "An AI agent in your browser's side panel: it reads and acts on your current tab, fast, and asks before anything irreversible.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "Open WebPilot",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "debugger", "tabs", "storage", "identity"],
  "host_permissions": ["https://openrouter.ai/*", "http://127.0.0.1/*", "http://localhost/*"]
}
