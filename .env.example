# === Model Runtime ===
# MODEL_PROVIDER=openrouter                     # openrouter | ollama
# MODEL_NAV_MODEL=google/gemini-3.8-flash       # Fast planner model
# MODEL_SYNTH_MODEL=anthropic/claude-sonnet-5   # Strong synth model
# MODEL_REVIEW_MODEL=google/gemini-3.8-flash    # Finish-review model
# MODEL_SYNTH_ENABLED=1                         # Enable synth pass on finish
# WEBPILOT_FAST_MODE=1                          # Jev picks browser actions (OpenRouter only)
# JEV_MODEL=typesafe/jev-1.13                   # Jev decision model
# MODEL_TIMEOUT_MS=120000                       # Per-call timeout (ms)

# OpenRouter credentials (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Ollama local runtime
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAV_MODEL=qwen3:8b

# === Browser ===
# CDP_HTTP=http://127.0.0.1:9222  # Chrome DevTools Protocol endpoint
# BROWSER_HEADLESS=false           # true = headless Chromium (auto-launch only)

# === Agent ===
# MAX_STEPS=160               # Max actions per run
# ALLOWED_DOMAINS=            # Comma-separated allowlist (empty = allow all)

# === Storage Paths ===
# RUN_STORE_DIR=./agent_runs

# === Artifacts ===
# CAPTURE_ARTIFACTS=1          # Save DOM snapshots per step
